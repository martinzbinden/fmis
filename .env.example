# Kopieren nach .env und mit echten Werten füllen (.env ist gitignored,
# echte Secrets gehören NIE ins Repo).

# Zufälliger, langer String — z.B. `openssl rand -hex 32`. Gilt jetzt für
# ALLE Module (ein Login, ein JWT-Secret für die ganze App).
JWT_SECRET=

# Wie lange eine Login-Session standardmässig gültig ist (Tage). Ein neuer
# Magic-Link kann jederzeit angefordert werden, unabhängig davon.
SESSION_TTL_DAYS=365

# Diese Adresse wird beim ersten Login automatisch als Admin freigeschaltet
# (Bootstrap — alle weiteren Adressen brauchen eine manuelle Rollenzuweisung
# durch einen bestehenden Admin).
INITIAL_ADMIN_EMAIL=

# Öffentliche URL der App (für den Link in der Login-Mail).
PUBLIC_URL=https://fmis.riedackerhof.ch
DOMAIN=fmis.riedackerhof.ch

# Anbindung an den vorhandenen Traefik (siehe docker-compose.yml, networks).
# Server (Default): web-netzwerk / web / false — TLS macht der Proxy davor.
# Lokal (~/git/dev-traefik-localhost): webproxy / websecure / true, dazu
# DOMAIN=fmis.riedackerhof.localhost und PUBLIC_URL=https://fmis.riedackerhof.localhost
TRAEFIK_NETWORK=web-netzwerk
TRAEFIK_ENTRYPOINT=web
TRAEFIK_TLS=false

# SMTP für den Mail-Versand der Login-Links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fmis@riedackerhof.ch
SMTP_USE_TLS=true

# NUR für Test-/Entwicklungsumgebungen — aktiviert POST /auth/password-login
# (direkter Admin-Login per Passwort statt Magic-Link, kein SMTP nötig).
# Auf dem echten Server LEER LASSEN.
TEST_LOGIN_PASSWORD=
